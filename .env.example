NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NOVALYTE_ACCESS_CODE=
NOVALYTE_SESSION_SECRET=
NOVALYTE_ADMIN_EMAIL=admin@novalyte.io
NEXT_PUBLIC_DATA_MODE=hybrid
ADMIN_DASHBOARD_URL=https://admin.novalyte.io

# Server-only provider configuration
FIRECRAWL_API_KEY=
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
GLM_API_KEY=
GLM_API_URL=
GLM_MODEL=glm-5
# Preferred long-form Journal model (Content Studio). Use glm-5.2 when available on your Zhipu/Z.ai plan.
GLM_LONGFORM_MODEL=glm-5.2

# Telnyx softphone — required for Founder-Led Calls (browser mic + speakers)
# TELNYX_API_KEY + TELNYX_CREDENTIAL_ID (WebRTC credential) + TELNYX_PHONE_NUMBER (E.164 caller ID)
TELNYX_API_KEY=
TELNYX_CREDENTIAL_ID=
TELNYX_PHONE_NUMBER=

# Deepgram (live stereo transcription + practice TTS)
DEEPGRAM_API_KEY=
DEEPGRAM_PROJECT_ID=

# Server-only PostHog API access for the dashboard live activity feed
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Google Analytics 4 remains a separate data source. Use a read-only service account.
GA4_PROPERTY_ID=
GA4_PROPERTY_URL=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Journal bridge to the public marketing site (server-only)
MARKETING_SITE_URL=https://novalyte.io
JOURNAL_PREVIEW_SECRET=
JOURNAL_REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Dialpad integration (OPTIONAL / DISABLED — Founder-Led uses Telnyx WebRTC)
# ---------------------------------------------------------------------------
# Keep disabled unless you intentionally roll back to Dialpad CTI.
# Founder-Led Calls dial from the browser via TELNYX_* below.
# Mode: disabled | mock | live. Never inferred from NODE_ENV.
DIALPAD_MODE=disabled
DIALPAD_INTEGRATION_ENABLED=false
# Optional; defaults to https://dialpad.com/api/v2
DIALPAD_API_BASE_URL=https://dialpad.com/api/v2
# Required in live mode. Server-only secret — never expose to the client.
DIALPAD_API_KEY=
# Required in live mode: the Dialpad user id whose devices ring for outbound calls.
DIALPAD_USER_ID=
# Optional: E.164 caller id shown to call recipients.
DIALPAD_OUTBOUND_CALLER_ID=
# Required in live mode. Shared secret used to verify HS256-signed webhooks. Server-only.
DIALPAD_WEBHOOK_SECRET=
# Optional CTI (embedded mini dialer). Requires Dialpad-provisioned client id
# and origin allowlisting. Off by default.
DIALPAD_CTI_ENABLED=false
DIALPAD_CTI_CLIENT_ID=
NEXT_PUBLIC_DIALPAD_CTI_ENABLED=false
# Public base URL of this deployment (used for webhook setup + CTI).
NEXT_PUBLIC_APP_URL=
# Protects /api/cron/* worker routes (Vercel Cron sends it as a Bearer token).
CRON_SECRET=
